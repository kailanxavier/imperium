#version 460
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct RayResult
{
	vec4 directionAndDistance;
	vec4 radiance;
};

layout(std430, binding = 0) readonly buffer RayResults
{
	RayResult rays[];
};

layout(std430, binding = 1) buffer HeatBuffer
{
	float heat[];
};

layout(push_constant) uniform PushConstants
{
	uint probeCountX;
	uint probeCountY;
	uint probeCountZ;
	uint raysPerProbe;
	float hysteresis;
	float inputScale;
	float maxHeat;
	float _pad0;
	vec3 minCorner;
	float probeSpacing;
} pc;

const vec3 kLuminance = vec3(0.2126, 0.7152, 0.0722);

void main()
{
	uint probeIndex = gl_GlobalInvocationID.x;
	uint probeCount = pc.probeCountX * pc.probeCountY * pc.probeCountZ;
	if (probeIndex >= probeCount)
		return;

	const uint rayBase = probeIndex * pc.raysPerProbe;
	vec3 totalRadiance = vec3(0.0);
	for (uint i = 0u; i < pc.raysPerProbe; ++i)
		totalRadiance += rays[rayBase + i].radiance.rgb;

	float avgLuminance = dot(totalRadiance / max(float(pc.raysPerProbe), 1.0), kLuminance);
	float heatInput = avgLuminance * pc.inputScale;

	float oldHeat = heat[probeIndex];
	float newHeat = mix(heatInput, oldHeat, pc.hysteresis);
	heat[probeIndex] = clamp(newHeat, 0.0, pc.maxHeat);
}
