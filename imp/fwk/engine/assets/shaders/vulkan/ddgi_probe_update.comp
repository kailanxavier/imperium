#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0, rgba16f) uniform image2D irradianceAtlas;
layout(binding = 1, rg16f) uniform image2D depthAtlas;

struct RayResult
{
	vec4 directionAndDistance;
	vec4 radiance;
};

layout(std430, binding = 2) readonly buffer RayResults
{
	RayResult rays[];
};

layout(push_constant) uniform PushConstants
{
	uint probeCountX;
	uint probeCountY;
	uint probeCountZ;
	uint raysPerProbe;
	uint irradianceTileTexels;
	uint depthTileTexels;
	uint isDepthPass;
	uint isBorderPass;
	float hysteresis;
	float depthSharpness;
} pc;

vec3 octDecode(vec2 f)
{
	vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
	float t = clamp(-n.z, 0.0, 1.0);
	n.x += n.x >= 0.0 ? -t : t;
	n.y += n.y >= 0.0 ? -t : t;
	return normalize(n);
}

void main()
{
	const uint tileTexels = pc.isDepthPass != 0u ? pc.depthTileTexels : pc.irradianceTileTexels;
	const uint interiorTexels = tileTexels - 2u;

	const uint globalX = gl_GlobalInvocationID.x;
	const uint globalY = gl_GlobalInvocationID.y;

	uint tileCol = globalX / tileTexels;
	uint tileRow = globalY / tileTexels;
	const uint localX = globalX % tileTexels;
	const uint localY = globalY % tileTexels;

	if (tileCol >= pc.probeCountX * pc.probeCountY || tileRow >= pc.probeCountZ)
		return;

	const uint probeX = tileCol % pc.probeCountX;
	const uint probeY = tileCol / pc.probeCountX;
	const uint probeZ = tileRow;
	const uint probeIndex = probeX + probeY * pc.probeCountX + probeZ * pc.probeCountX * pc.probeCountY;

	bool isBorder = (localX == 0u || localX == tileTexels - 1u || localY == 0u || localY == tileTexels - 1u);
	const ivec2 texelCoord = ivec2(int(tileCol * tileTexels + localX), int(tileRow * tileTexels + localY));

	if (pc.isBorderPass != 0u)
	{
		if (!isBorder)
			return;

		uint interiorX = clamp(localX, 1u, tileTexels - 2u) - 1u;
		uint interiorY = clamp(localY, 1u, tileTexels - 2u) - 1u;
		const ivec2 interiorCoord = ivec2(int(tileCol * tileTexels + interiorX + 1u), int(tileRow * tileTexels + interiorY + 1u));

		if (pc.isDepthPass != 0u)
			imageStore(depthAtlas, texelCoord, imageLoad(depthAtlas, interiorCoord));
		else
			imageStore(irradianceAtlas, texelCoord, imageLoad(irradianceAtlas, interiorCoord));
		return;
	}

	if (isBorder)
		return;

	const uint interiorX = localX - 1u;
	const uint interiorY = localY - 1u;

	const vec2 octUV = (vec2(interiorX, interiorY) + 0.5) / float(interiorTexels) * 2.0 - 1.0;
	const vec3 texelDir = octDecode(octUV);

	vec3 weightedRadiance = vec3(0.0);
	float weightedDistance = 0.0;
	float weightedDistanceSq = 0.0;
	float totalWeight = 0.0;

	const uint rayBase = probeIndex * pc.raysPerProbe;
	for (uint i = 0u; i < pc.raysPerProbe; ++i)
	{
		RayResult r = rays[rayBase + i];
		const vec3 rayDir = r.directionAndDistance.xyz;
		const float hitDistance = r.directionAndDistance.w;

		const float cosWeight = dot(texelDir, rayDir);
		if (cosWeight <= 0.0)
			continue;

		if (pc.isDepthPass != 0u)
		{
			const float depthWeight = pow(cosWeight, pc.depthSharpness);
			weightedDistance += hitDistance * depthWeight;
			weightedDistanceSq += hitDistance * hitDistance * depthWeight;
			totalWeight += depthWeight;
		}
		else
		{
			weightedRadiance += r.radiance.rgb * cosWeight;
			totalWeight += cosWeight;
		}
	}


	if (pc.isDepthPass != 0u)
	{
		const vec2 newMoments = (totalWeight > 0.0) ? vec2(weightedDistance, weightedDistanceSq) / totalWeight : vec2(0.0);
		const vec2 oldMoments = imageLoad(depthAtlas, texelCoord).rg;
		const vec2 resolved = (totalWeight > 0.0) ? newMoments : oldMoments;
		const vec2 blended = mix(resolved, oldMoments, pc.hysteresis);
		imageStore(depthAtlas, texelCoord, vec4(blended, 0.0, 0.0));
	}
	else
	{
		const vec3 newRadiance = (totalWeight > 0.0) ? (weightedRadiance / totalWeight) : vec3(0.0);
		vec3 oldRadiance = imageLoad(irradianceAtlas, texelCoord).rgb;
		const vec3 resolved = (totalWeight > 0.0) ? newRadiance : oldRadiance;
		const vec3 blended = mix(resolved, oldRadiance, pc.hysteresis);
		imageStore(irradianceAtlas, texelCoord, vec4(blended, 1.0));
	}
}
