#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0, rgba16f) uniform image2D irradianceAtlas;
layout(binding = 1, rg16f) uniform image2D depthAtlas;
layout(binding = 2) uniform accelerationStructureEXT tlas;

struct InstanceMaterial
{
	vec4 baseColour;
	vec4 metallicRoughness;
};

layout(std430, binding = 3) readonly buffer InstanceMaterials
{
	InstanceMaterial materials[];
};

#define MAX_LIGHTS 16
struct GPULight
{
	vec4 positionOrDirWS;
	vec4 colourIntensity;
};

layout(binding = 4) uniform LightDataUBO
{
	vec4 cameraPositionWS;
	vec4 ambientColour;
	float specularStrength;
	float shininess;
	uint lightCount;
	uint _pad0;
	mat4 sunViewProj;
	vec3 sunDirection;
	float shadowMapSize;
	GPULight lights[MAX_LIGHTS];
} lightData;

layout(push_constant) uniform PushConstants
{
	uint probeCountX;
	uint probeCountY;
	uint probeCountZ;
	uint irradianceTileTexels;
	uint depthTileTexels;
	uint isDepthPass;
	float maxRayDistance;
	float hysteresis;
	float probeSpacing;
	float minCornerX;
	float minCornerY;
	float minCornerZ;
	float normalBias;
	float viewBias;
} pc;

const float PI = 3.14159265359;

vec3 octDecode(vec2 f)
{
	vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
	float t = clamp(-n.z, 0.0, 1.0);
	n.x += n.x >= 0.0 ? -t : t;
	n.y += n.y >= 0.0 ? -t : t;

	return normalize(n);
}
bool isOccluded(vec3 origin, vec3 dir, float tMax)
{
	rayQueryEXT rq;
	rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, origin, 0.0, dir, tMax);
	while (rayQueryProceedEXT(rq)) {}
	return rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
}

void main()
{
	const uint tileTexels = pc.isDepthPass != 0u ? pc.depthTileTexels : pc.irradianceTileTexels;
	const uint interiorTexels = tileTexels - 2u;

	const uint globalX = gl_GlobalInvocationID.x;
	const uint globalY = gl_GlobalInvocationID.y;

	uint tileCol = globalX / interiorTexels;
	uint tileRow = globalY / interiorTexels;
	const uint localX = globalX % interiorTexels;
	const uint localY = globalY % interiorTexels;

	if (tileCol >= pc.probeCountX * pc.probeCountY || tileRow >= pc.probeCountZ)
		return;

	// Inverse of DDGIVolume::probeAtlasColumn(x, y) = x + y * probeCountX.
	const uint probeX = tileCol % pc.probeCountX;
	const uint probeY = tileCol / pc.probeCountX;
	const uint probeZ = tileRow;

	const vec3 probePos = vec3(pc.minCornerX, pc.minCornerY, pc.minCornerZ)
						+ vec3(probeX, probeY, probeZ);

	const vec2 octUV = (vec2(localX, localY) + 0.5) / float(interiorTexels) * 2.0 - 1.0;
	const vec3 rayDir = octDecode(octUV);

	rayQueryEXT rq;
	rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, probePos, pc.normalBias, rayDir, pc.maxRayDistance);
	while (rayQueryProceedEXT(rq)) {}

	float hitDistance = pc.maxRayDistance;
	vec3 radiance = vec3(0.0);

	if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
	{
		hitDistance = rayQueryGetIntersectionTEXT(rq, true);
		const uint instanceIndex = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
		const vec3 hitPos = probePos + rayDir * hitDistance;

		const vec3 hitNormal = -rayDir;
		const InstanceMaterial material = materials[instanceIndex];
		const vec3 albedo = material.baseColour.rgb;

		vec3 direct = lightData.ambientColour.rgb * albedo;

		for (uint i = 0u; i < lightData.lightCount; ++i)
		{
			const GPULight light = lightData.lights[i];
			const bool isPoint = light.positionOrDirWS.w > 0.5;

			const vec3 toLight = isPoint ? light.positionOrDirWS.xyz - hitPos : -light.positionOrDirWS.xyz;
			const vec3 L = normalize(toLight);

			const float NdotL = max(dot(hitNormal, L), 0.0);
			if (NdotL <= 0.0)
				continue;

			const float shadowTMax = isPoint ? length(toLight) : pc.maxRayDistance;
			if (isOccluded(hitPos + hitNormal * pc.viewBias, L, shadowTMax))
				continue;

			const vec3 lightRadiance = light.colourIntensity.rgb * light.colourIntensity.w;
			direct += albedo * lightRadiance * NdotL;
		}

		radiance = direct;
	}

	const ivec2 texelCoord = ivec2(int(tileCol * tileTexels + 1u + localX), int(tileRow * tileTexels + 1u + localY));

	if (pc.isDepthPass != 0u)
	{
		const vec2 newMoments = vec2(hitDistance, hitDistance * hitDistance);
		const vec2 oldMoments = imageLoad(depthAtlas, texelCoord).rg;
		const vec2 blended = mix(newMoments, oldMoments, pc.hysteresis);
		imageStore(depthAtlas, texelCoord, vec4(blended, 0.0, 0.0));
	}
	else
	{
		const vec3 oldRadiance = imageLoad(irradianceAtlas, texelCoord).rgb;
		const vec3 blended = mix(radiance, oldRadiance, pc.hysteresis);
		imageStore(irradianceAtlas, texelCoord, vec4(blended, 1.0));
	}
}
